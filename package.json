{
  "name": "deskpet",
  "version": "1.2.0",
  "description": "桌宠合集：初音未来（即刻轮回 / 经典）、福贺久留美（FX战士）、芙宁娜（魔法偶像）……立绘动画、拖拽抛掷、番茄钟、待办、提醒、猜拳、运势、FX 模拟盘、歌剧院审判",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "author": "wldinhy",
  "repository": {
    "type": "git",
    "url": "https://github.com/wldinhy/miku-deskpet.git"
  },
  "keywords": [
    "desktop-pet",
    "electron",
    "hatsune-miku",
    "fx-kurumi",
    "furina"
  ],
  "build": {
    "appId": "com.miku.deskpet",
    "productName": "Deskpet",
    "copyright": "Code MIT © 2026 wldinhy · Hatsune Miku © Crypton Future Media, INC. · FX戦士くるみちゃん: でむにゃん / 炭酸だいすき · Furina (Genshin Impact) © HoYoverse",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "js/**",
      "assets/gen/**",
      "assets/skins/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "桌宠",
      "uninstallDisplayName": "桌宠",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "artifactName": "Deskpet-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Deskpet-Portable-${version}.exe"
    }
  }
}
